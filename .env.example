# =============================================================================
# Gestión Territorial Lista 47 · Variables de entorno
# Copiá este archivo como .env.local (desarrollo) y cargá los mismos valores en
# Vercel → Project → Settings → Environment Variables (producción).
# NUNCA subas .env.local ni claves reales a GitHub.
# =============================================================================

# --- Datos -------------------------------------------------------------------
# sheets = Google Sheets (obligatorio en Vercel)
# local  = archivo .data/local-db.json (solo para probar en tu computadora)
DATA_BACKEND=local

# ID de la planilla maestra: la parte entre /d/ y /edit en la URL de Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=

# Cuenta de servicio (Google Cloud → IAM → Cuentas de servicio → Claves → JSON)
# Compartí la planilla con este email como EDITOR.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Pegá la private_key del JSON entre comillas, con los \n tal cual
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Acceso -------------------------------------------------------------------
# Cliente OAuth "Aplicación web" (Google Cloud → APIs y servicios → Credenciales)
# URI de redirección autorizado: {APP_URL}/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Administradores iniciales (separados por coma). Siempre entran como ADMINISTRADOR
# aunque todavía no estén en la hoja USUARIOS. El resto se administra desde la app.
ADMIN_EMAILS=eduhidalgomoro@gmail.com
# Secreto para firmar la sesión: mínimo 32 caracteres al azar.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Solo desarrollo local: botones "Entrar como…" sin Google. Ignorado en producción.
AUTH_DEV_LOGIN=false

# URL pública de la app (sin barra final). En Vercel: https://tu-app.vercel.app o tu dominio
APP_URL=http://localhost:3000

# --- Protección contra envíos simultáneos y spam (recomendado en producción) ---
# Upstash Redis (Vercel → Storage / Marketplace → Upstash). Acepta cualquiera de los dos pares.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Región -------------------------------------------------------------------
APP_TIMEZONE=America/Argentina/Buenos_Aires
